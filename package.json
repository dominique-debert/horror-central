{
  "name": "horror-central",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @horror-central/api dev\" \"pnpm --filter @horror-central/web dev\"",
    "build": "pnpm --filter @horror-central/api build && pnpm --filter @horror-central/web build",
    "start": "concurrently \"pnpm --filter @horror-central/api start\" \"pnpm --filter @horror-central/web start\"",
    "lint": "pnpm --filter @horror-central/api lint && pnpm --filter @horror-central/web lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prisma:generate": "pnpm --filter @horror-central/api prisma:generate",
    "prisma:migrate": "pnpm --filter @horror-central/api prisma:migrate",
    "prisma:studio": "pnpm --filter @horror-central/api prisma:studio"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5"
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4",
    "uuid": "^11.1.0"
  }
}
