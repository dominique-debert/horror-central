{
  "name": "horror-central",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm --filter @horror-central/api dev\" \"pnpm --filter web dev\"",
    "build": "pnpm --filter @horror-central/api build && pnpm --filter web build",
    "start": "pnpm --filter @horror-central/api start",
    "lint": "pnpm --filter @horror-central/api lint && pnpm --filter web lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@8.14.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.292.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  }
}
